# Copy to .env and fill in. .env is gitignored; never commit real values.
# Local: the docker-compose database. Staging (Render): Neon's pooled connection
# string, which ends in ?sslmode=require.
DATABASE_URL=postgres://gameplan:gameplan@localhost:5432/gameplan
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Sent by the app on every /catalog request. Not a secret (it ships in the app),
# but make it long: openssl rand -hex 24
CATALOG_API_KEY=
# Auth (module 7). Each at least 32 characters: openssl rand -hex 32
JWT_SECRET=
CODE_SECRET=
# console prints sign-in codes to this terminal (dev only; refused when
# NODE_ENV=production). resend sends real email and needs the two below.
EMAIL_TRANSPORT=console
RESEND_API_KEY=
# Without a verified domain, Resend's sandbox sender: Gameplan <onboarding@resend.dev>
EMAIL_FROM=
# Comma-separated origins allowed by CORS; empty until the web app exists.
CORS_ORIGINS=
