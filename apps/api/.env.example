# Copy to .env and fill in. .env is gitignored; never commit real values.
# Local: the docker-compose database. Staging (Render): Neon's pooled connection
# string, which ends in ?sslmode=require.
DATABASE_URL=postgres://gameplan:gameplan@localhost:5432/gameplan
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Sent by the app on every /catalog request. Not a secret (it ships in the app),
# but make it long: openssl rand -hex 24
CATALOG_API_KEY=
