{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "db:roles": "tsx src/scripts/bootstrap-roles.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/index.mjs",
    "migrate:built": "node --enable-source-maps dist/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage",
    "igdb:smoke": "tsx src/scripts/igdb-smoke.ts",
    "capture:games": "tsx src/scripts/capture-games.ts"
  },
  "dependencies": {
    "@gameplan/contracts": "workspace:*",
    "@gameplan/domain": "workspace:*",
    "@gameplan/sync": "workspace:*",
    "@gameplan/sync-server": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.6.14",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@gameplan/config": "workspace:*",
    "@gameplan/storage": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
