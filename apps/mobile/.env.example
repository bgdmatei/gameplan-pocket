# Copy to .env (gitignored). Expo inlines EXPO_PUBLIC_* into the app at build
# time, so none of these may be secrets.
#
# For a Release build against staging, copy again to .env.staging with
# staging's URL and key, and run `pnpm --filter mobile ios:staging`. Variables
# already in the environment win over .env, so the staging values are the
# ones inlined.

# The catalog API. The iOS simulator reaches your Mac as localhost; a phone
# needs the Mac's LAN address (or staging, once it exists).
EXPO_PUBLIC_API_URL=http://localhost:3000

# The same value as CATALOG_API_KEY in apps/api/.env.
EXPO_PUBLIC_API_KEY=
