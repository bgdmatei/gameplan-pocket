{
  "name": "gameplan-pocket",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "pnpm --filter mobile start",
    "dev:ios": "pnpm --filter mobile dev:ios",
    "dev:android": "pnpm --filter mobile dev:android",
    "dev:web": "echo 'The web app is a separate Next.js app (apps/web), built in module 14 \u2014 not the mobile app in a browser. See SPEC-map.md.' && exit 1",
    "dev:api": "pnpm --filter api dev",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "build": "turbo run build",
    "format": "turbo run format",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "op-sqlite": {
    "fts5": true
  },
  "devDependencies": {
    "@gameplan/config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.1",
    "prettier": "^3.4.2",
    "turbo": "^2.5.5",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  }
}
